{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  // patch-package runs from scripts/postinstall.ts with cwd=packages/desktop,
  // which the static import scan cannot see.
  "ignoreDependencies": ["patch-package"],
  // `screencapture` is the macOS system binary spawned by
  // packages/desktop/src/main/app/index.ts, not an npm binary.
  // `pandoc` is the same story twice over: the app shells out to it for the
  // EPUB/LaTeX/RTF/OPML exports, and the export spec probes for it (to skip on
  // machines without it) rather than depending on it.
  "ignoreBinaries": ["screencapture", "pandoc"]
}
