shamefully-hoist=true
clang=0
# Forces electron/rebuild to use gcc/g++ instead of clang on Linux and msvc on Windows
# Do not pin msvs_version here: `pnpm run` injects npm config into script env,
# and a pinned year makes node-gyp reject any other installed Visual Studio
# (e.g. a VS2026-only machine fails with "Could not find any Visual Studio
# installation to use"). Let node-gyp auto-detect the newest installed VS.